<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Landis.Extension.FPS-v1</AssemblyName>
    <RootNamespace>Landis.Extension.FPS</RootNamespace>
    <ApplicationIcon />
    <StartupObject />
    <Version>1.1</Version>
    <AssemblyVersion>1.1</AssemblyVersion>
    <FileVersion>1.1</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>bin\Debug\</OutputPath>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="copy &quot;C:\GitHub\Extension-Forest-Product-Sector\bin\Release\net8.0\$(TargetName).dll&quot;  &quot;C:\Program Files\LANDIS-II-v8\extensions&quot;" />
  </Target>
  <ItemGroup>
    <Compile Remove="Complex Tier 3 example with full functionality\**" />
    <Compile Remove="lib\**" />
    <Compile Remove="Simple Tier 1 example\**" />
    <EmbeddedResource Remove="Complex Tier 3 example with full functionality\**" />
    <EmbeddedResource Remove="lib\**" />
    <EmbeddedResource Remove="Simple Tier 1 example\**" />
    <None Remove="Complex Tier 3 example with full functionality\**" />
    <None Remove="lib\**" />
    <None Remove="Simple Tier 1 example\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove=".gitattributes" />
    <None Remove=".gitignore" />
    <None Remove="FPSMv1-1of2.zip" />
    <None Remove="FPSMv2-2of2.zip" />
    <None Remove="LANDIS-II ForestProducts v1.0  User Guide Nov 18 2024.pdf" />
    <None Remove="LICENSE" />
    <None Remove="LICENSE.txt" />
    <None Remove="README.md" />
    <None Remove="runPub.bat" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Landis.Core" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Landis.Library.Metadata-v2">
      <HintPath>lib\Landis.Library.Metadata-v2.dll</HintPath>
    </Reference>
    <Reference Include="Landis.Library.Parameters-v2">
      <HintPath>lib\Landis.Library.Parameters-v2.dll</HintPath>
    </Reference>
    <Reference Include="MathNet.Numerics">
      <HintPath>lib\MathNet.Numerics.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
