<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for building this extension.

  The LANDIS-II Core libraries (Landis.Core, Landis.Utilities,
  Landis.SpatialModeling, Landis.Datasets) are published to the LANDIS-II
  Foundation's MyGet feed, not to nuget.org; see the Core-Model-v8 README.
  Without this file, `dotnet restore` consults nuget.org only and cannot
  resolve the Landis.Core PackageReference in FPS.csproj, so the project
  builds only on a machine where that feed is already registered globally.

  The <clear /> element drops any inherited machine or user level sources, so
  a build here resolves from the same two feeds everywhere, including CI.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="landis-ii-v8" value="https://www.myget.org/F/landis-ii-v8/api/v3/index.json" />
  </packageSources>
</configuration>
